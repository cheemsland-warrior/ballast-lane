using AutoMapper;
using Microsoft.Extensions.DependencyInjection;
using System;

namespace API.Extensions
{
    public static class AutoMapperExtensions
    {
        public static IServiceCollection AddAutoMapperWithValidation(
            this IServiceCollection services,
            bool isDevelopment)
        {
            services.AddAutoMapper(typeof(MappingProfiles));

            // Note: Validation moved to after host is built to avoid issues with dependency injection
            // during ConfigureServices. See Program.cs for validation logic if needed.

            return services;
        }
    }
}
